SERVER_URL=https://gpu.yourdomain.com
AGENT_TOKEN=change-me-to-a-long-random-secret

# Optional overrides
PUSH_INTERVAL_SECONDS=15
BACKUP_POLL_EVERY_TICKS=4
VENV_PYTHON=/home/user2/venvs/oceanembed/bin/python
PIP_CACHE_DIR=~/.cache/pip
GIT_INSTALL_DIR=~/local/git
SPEEDTEST_BIN=~/local/speedtest/speedtest

# agent.log is capped and self-rotating (see LOG_FILE/LOG_MAX_BYTES/
# LOG_BACKUP_COUNT below) — this matters because the dashboard's tunnel
# isn't always reachable, and failed pushes would otherwise log forever.
# LOG_FILE=/path/to/agent.log
# LOG_MAX_BYTES=20000
# LOG_BACKUP_COUNT=1
