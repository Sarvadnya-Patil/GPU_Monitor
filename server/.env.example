# Shared secret the GPU-side agent must present as a Bearer token.
AGENT_TOKEN=change-me-to-a-long-random-secret

# Optional: protect the dashboard behind a login page.
# Leave both blank to leave the dashboard open (fine if Cloudflare Access
# or similar is already gating access at the tunnel).
DASHBOARD_USER=
DASHBOARD_PASS=

# Optional: secret used to sign session cookies after login. Falls back to
# AGENT_TOKEN if unset, so this only needs to be set if you want a separate
# secret for the two.
SESSION_SECRET=

# Set to "false" only for local http:// testing without Docker/Cloudflare —
# leave "true" (default) for any real deployment, since the tunnel serves
# the dashboard over https.
COOKIE_SECURE=true
