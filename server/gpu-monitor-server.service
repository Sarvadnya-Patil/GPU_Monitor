[Unit]
Description=GPU Monitor dashboard server
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/YOUR_USER/gpu-monitor/server
EnvironmentFile=/home/YOUR_USER/gpu-monitor/server/.env
ExecStart=/home/YOUR_USER/gpu-monitor/server/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
